+      // traerla. "A firme" es la venta simple, sin condiciones.
+      a.CodModVenta = 1;
+      avisos.push('el set no trae MODALIDAD DE VENTA; se informa 1 (A FIRME)');
+    }
+    if (caso.clausulaVenta) {
