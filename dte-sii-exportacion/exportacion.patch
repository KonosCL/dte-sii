+  assert.equal(docs[0].transporte.Aduana.CodPtoEmbarque, 906);
+  for (const d of docs) {
+    const pdf = await muestras.generarPDFBuffer(d, {});
+    assert.equal(pdf.subarray(0, 4).toString(), '%PDF');
+  }
+});
