# /etc/certificador/panel.env — lo lee systemd al arrancar el panel (chmod 600, dueño root).
# Nada de esto va en los .env de las empresas.

# Clave de entrada del equipo (mínimo 10 caracteres).
PANEL_CLAVE=

# Certificado digital que firma y entra al SII. Ruta absoluta, fuera de /opt/certificador.
CERT_PATH=/etc/certificador/certificado.pfx
CERT_PASSWORD=

# Opcionales
# PANEL_HOST=127.0.0.1
# PANEL_PUERTO=8080
# PANEL_COOKIE_SEGURA=1
